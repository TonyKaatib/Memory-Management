<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SpaceLedger_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SpaceLedger_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This is the main content area of your application.
        Add your UI elements here — for example, controls, layouts, and data-bound views.
        Use 'dotnet new winui-page' to create additional pages and navigate to them via
        the Frame in MainWindow (RootFrame).
    -->
    <ScrollViewer>
        <StackPanel MaxWidth="1200" Padding="28,24,28,32" Spacing="18" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Where did the space go?" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Take a snapshot when you choose. Compare it with another scan to see what changed."
                           Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Folder to examine" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderPathBox" PlaceholderText="Choose a local NTFS folder"
                                 AutomationProperties.Name="Folder to examine" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="Browse_Click" />
                        <Button x:Name="LoadButton" Grid.Column="2" Content="Load history" Click="LoadHistory_Click" />
                    </Grid>
                    <Expander Header="History file (advanced)">
                        <StackPanel Spacing="6" Padding="0,8,0,0">
                            <TextBlock Text="The default is private to your Windows account. Change this only to open another SpaceLedger database."
                                       Opacity="0.72" TextWrapping="Wrap" />
                            <TextBox x:Name="DatabasePathBox" AutomationProperties.Name="History database path" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="ScanButton" Content="Scan now" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="CancelButton" Content="Cancel scan" Click="Cancel_Click" Visibility="Collapsed" />
                        <ProgressRing x:Name="ScanSpinner" IsActive="False" Width="20" Height="20" Visibility="Collapsed" />
                        <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Text="No scan in progress" Opacity="0.72" />
                    </StackPanel>
                    <InfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational"
                             Message="Nothing is monitored automatically. Choose a folder and scan when you're ready." />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Saved scans" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="HistoryHint" Text="Choose a folder to see its history." TextWrapping="Wrap" Opacity="0.72" />
                        <ListView x:Name="HistoryList" SelectionMode="None" MinHeight="190" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Padding="0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Compare two scans" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="BeforePicker" Header="Earlier" DisplayMemberPath="Label"
                                      HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="AfterPicker" Grid.Column="1" Header="Later" DisplayMemberPath="Label"
                                      HorizontalAlignment="Stretch" />
                            <Button x:Name="CompareButton" Grid.Column="2" Content="Compare"
                                    Click="Compare_Click" VerticalAlignment="Bottom" IsEnabled="False" />
                        </Grid>
                        <TextBlock x:Name="ResultHeadline" Text="Two scans are needed to show changes."
                                   FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResultDetail" Text="No comparison loaded." Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock x:Name="SizeExplanation" Visibility="Collapsed" Opacity="0.72" TextWrapping="Wrap"
                                   Text="Allocated is disk space attributed to files in this folder; logical is their file length. Whole-drive free space includes activity elsewhere and cannot be explained by this folder alone." />
                        <InfoBar x:Name="CoverageBar" Severity="Warning" IsOpen="False" />
                        <TextBlock Text="Folder changes" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock x:Name="FolderChangeSummary" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <ListView x:Name="FolderChangesList" SelectionMode="None" MinHeight="110" MaxHeight="270">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="File changes" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FileFilterBox" PlaceholderText="Filter by path or change type"
                                     AutomationProperties.Name="Filter file changes" TextChanged="FileFilter_TextChanged" />
                            <ComboBox x:Name="FileSortBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Sort file changes" SelectedIndex="0"
                                      SelectionChanged="FileSort_SelectionChanged">
                                <ComboBoxItem Content="Largest change first" />
                                <ComboBoxItem Content="Growth first" />
                                <ComboBoxItem Content="Space freed first" />
                                <ComboBoxItem Content="Path A–Z" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="FileChangeSummary" FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                        <ListView x:Name="FileChangesList" SelectionMode="None" MinHeight="110" MaxHeight="270">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="Folder rows include descendants and overlap; don't add their values together. Added or removed files may have moved into or out of this folder."
                                   FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="DatabaseLocation" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
